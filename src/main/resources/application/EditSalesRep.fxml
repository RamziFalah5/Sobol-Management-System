<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Rectangle?>

<AnchorPane prefWidth="900" prefHeight="600"
	xmlns="http://javafx.com/javafx/23.0.1"
	xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="application.EditSalesRepController"
	style="-fx-background-color:#f7f8fb;">

	<Label layoutX="28" layoutY="20" text="Edit Sales Representative"
		style="-fx-font-size:24px; -fx-text-fill:#f7931e; -fx-font-weight:bold;" />

	<AnchorPane layoutX="28" layoutY="60" prefWidth="844"
		prefHeight="500"
		style="-fx-background-color:white; -fx-background-radius:14; -fx-padding:20;
                       -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 20, 0, 0, 4);">

		<GridPane layoutX="20" layoutY="40" hgap="14" vgap="12">

			<Label text="Full Name:" />
			<TextField fx:id="txtFullName" prefWidth="240"
				GridPane.columnIndex="1" />

			<Label text="Phone:" GridPane.rowIndex="1" />
			<TextField fx:id="txtPhone" GridPane.columnIndex="1"
				GridPane.rowIndex="1" />

			<Label text="Branch:" GridPane.rowIndex="2" />
			<ComboBox fx:id="cbBranch" prefWidth="240"
				promptText="Select branch..." GridPane.columnIndex="1"
				GridPane.rowIndex="2" />

			<Label text="Hire Date:" GridPane.rowIndex="3" />
			<DatePicker fx:id="dpHireDate" GridPane.columnIndex="1"
				GridPane.rowIndex="3" />

			<Label text="Daily Rate:" GridPane.rowIndex="4" />
			<TextField fx:id="txtDailyRate" GridPane.columnIndex="1"
				GridPane.rowIndex="4" promptText="e.g. 120" />

			<Label text="Commission %:" GridPane.rowIndex="5" />
			<TextField fx:id="txtCommission" GridPane.columnIndex="1"
				GridPane.rowIndex="5" promptText="e.g. 5" />

			<Label text="Image:" GridPane.rowIndex="6" />
			<HBox spacing="10" GridPane.columnIndex="1"
				GridPane.rowIndex="6">
				<Button text="Choose…" onAction="#chooseImage"
					style="-fx-background-color:#f7931e; -fx-text-fill:white; -fx-background-radius:10;" />
				<Label fx:id="lblImageInfo" text="No image selected"
					style="-fx-text-fill:#777;" />
			</HBox>

		</GridPane>

		<StackPane layoutX="520" layoutY="60" prefWidth="200"
			prefHeight="200"
			style="-fx-border-color:#ddd; -fx-border-radius:0; -fx-background-radius:0;">
			<clip>
				<Rectangle width="200" height="200" arcWidth="0"
					arcHeight="0" />
			</clip>
			<children>
				<ImageView fx:id="imgPreview" fitWidth="200"
					fitHeight="200" preserveRatio="true" />
			</children>
		</StackPane>

		<HBox layoutX="22" layoutY="451" spacing="14">
			<Button fx:id="btnAnchor" text="Save" onAction="#onSave"
				style="-fx-background-color:#2E7D32; -fx-text-fill:white; -fx-pref-width:110; -fx-background-radius:10;" />
			<Button text="Cancel" onAction="#onCancel"
				style="-fx-background-color:#C62828; -fx-text-fill:white; -fx-pref-width:110; -fx-background-radius:10;" />
		</HBox>

	</AnchorPane>
</AnchorPane>
