		style="-fx-background-color:transparent;">
		<content>
			<VBox spacing="16.0" prefWidth="854.0">

				<!-- ===== HERO CARD ===== -->
				<AnchorPane prefHeight="140.0" prefWidth="854.0"
					style="-fx-background-color:linear-gradient(to right, #111827, #0f172a); -fx-background-radius:16; -fx-effect:dropshadow(gaussian, rgba(0,0,0,0.18), 24, 0, 0, 6);">
					<children>
						<VBox layoutX="18" layoutY="18" spacing="6">
							<Label text="Inventory Suite • Control Center"
								style="-fx-font-size:20px; -fx-font-weight:900; -fx-text-fill:white;" />
							<Label
								text="Themes, preferences, security, notifications, and more."
								style="-fx-font-size:13px; -fx-text-fill:#cbd5e1;" />
							<HBox spacing="10" layoutY="78">

								<StackPane prefHeight="34" prefWidth="160"
