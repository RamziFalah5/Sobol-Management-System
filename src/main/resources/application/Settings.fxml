			<Label text="Settings"
				style="-fx-font-size:26px; -fx-font-weight:800; -fx-text-fill:#111827;" />
			<Label
				text="Customize your system experience • UI only (no backend)"
				style="-fx-font-size:12.5px; -fx-text-fill:#6b7280;" />
		</VBox>

		<Region HBox.hgrow="ALWAYS" />

		<HBox spacing="10" alignment="CENTER_RIGHT">
			<StackPane prefWidth="170" prefHeight="36"
				style="-fx-background-color:white; -fx-background-radius:10; -fx-border-radius:10; -fx-border-color:#e5e7eb;">
				<HBox spacing="8" alignment="CENTER_LEFT">
					<padding>
						<Insets top="0" right="10" bottom="0" left="10" />
					</padding>
					<Circle radius="5" style="-fx-fill:#22c55e;" />
					<Label text="System: Online"
						style="-fx-text-fill:#111827; -fx-font-weight:700;" />
				</HBox>
			</StackPane>

			<Button text="Save"
				style="-fx-background-color:#f7931e; -fx-text-fill:white; -fx-font-weight:800; -fx-background-radius:10; -fx-pref-height:36; -fx-pref-width:110;" />
			<Button text="Reset"
				style="-fx-background-color:#111827; -fx-text-fill:white; -fx-font-weight:800; -fx-background-radius:10; -fx-pref-height:36; -fx-pref-width:110;" />
		</HBox>
	</HBox>

