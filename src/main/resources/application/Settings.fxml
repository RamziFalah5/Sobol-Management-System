											style="-fx-text-fill:white; -fx-font-weight:800;" />
									</HBox>
								</StackPane>

							</HBox>
						</VBox>

						<Rectangle layoutX="660" layoutY="18" width="170"
							height="110" arcWidth="18" arcHeight="18"
							style="-fx-fill:rgba(255,255,255,0.06); -fx-stroke:rgba(255,255,255,0.08);" />
						<Circle layoutX="770" layoutY="72" radius="38"
							style="-fx-fill:rgba(247,147,30,0.20);" />
						<Circle layoutX="720" layoutY="110" radius="18"
							style="-fx-fill:rgba(96,165,250,0.20);" />
					</children>
				</AnchorPane>

