										style="-fx-text-fill:#6b7280;" />
								</VBox>
								<Region HBox.hgrow="ALWAYS" />
								<Button text="Switch"
									style="-fx-background-color:#f7931e; -fx-text-fill:white; -fx-font-weight:900; -fx-background-radius:10;" />
							</HBox>

							<HBox spacing="10" alignment="CENTER_LEFT">
								<Label text="Name" prefWidth="110"
									style="-fx-text-fill:#374151; -fx-font-weight:800;" />
								<TextField prefWidth="260" promptText="Full name"
									style="-fx-background-radius:10; -fx-border-radius:10; -fx-border-color:#e5e7eb;" />
							</HBox>

							<HBox spacing="10" alignment="CENTER_LEFT">
