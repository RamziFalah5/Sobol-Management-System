									style="-fx-background-color:#ef4444; -fx-text-fill:white; -fx-font-weight:900; -fx-background-radius:10; -fx-pref-width:110;" />
							</HBox>
						</VBox>

						<!-- About -->
						<VBox spacing="8"
							style="-fx-background-color:white; -fx-background-radius:16; -fx-border-color:#e5e7eb; -fx-border-radius:16;">
