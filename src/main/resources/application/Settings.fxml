									style="-fx-background-color:rgba(255,255,255,0.10); -fx-background-radius:10; -fx-border-radius:10; -fx-border-color:rgba(255,255,255,0.15);">
									<HBox spacing="8" alignment="CENTER_LEFT">
										<padding>
											<Insets top="0" right="12" bottom="0" left="12" />
