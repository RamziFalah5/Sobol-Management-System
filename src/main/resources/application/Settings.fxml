							<HBox spacing="10" alignment="CENTER_LEFT">
								<Label text="Animations" prefWidth="110"
									style="-fx-text-fill:#374151; -fx-font-weight:800;" />
								<CheckBox text="Enable smooth transitions"
									selected="true"
									style="-fx-text-fill:#111827; -fx-font-weight:700;" />
							</HBox>
						</VBox>

						<!-- Notifications Card -->
						<VBox spacing="12"
							style="-fx-background-color:white; -fx-background-radius:16; -fx-border-color:#e5e7eb; -fx-border-radius:16; -fx-effect:dropshadow(gaussian, rgba(0,0,0,0.06), 20, 0, 0, 4);">
