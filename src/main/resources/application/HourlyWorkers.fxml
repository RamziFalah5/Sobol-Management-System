<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<AnchorPane prefHeight="650" prefWidth="946.0" style="-fx-background-color:#f7f8fb;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.HourlyWorkersController">

	<!-- ===== Title ===== -->
	<Label layoutX="28" layoutY="22" style="-fx-font-size:22px;                -fx-text-fill:#f7931e;                -fx-font-weight:900;" text="Hourly Workers" />

	<!-- subtle underline -->
	<Region layoutX="28" layoutY="50" prefHeight="2" prefWidth="854" style="-fx-background-color: rgba(247,147,30,0.25);                -fx-background-radius:10;" />

	<!-- ===== Table Card ===== -->
	<AnchorPane layoutX="28" layoutY="70" prefHeight="517.0" prefWidth="846.0" style="             -fx-background-color:white;             -fx-background-radius:14;             -fx-padding:14;             -fx-border-color:#e8e8e8;             -fx-border-radius:14;             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 18, 0, 0, 4);         ">

		<TableView fx:id="table" layoutX="23.0" layoutY="14.0" prefHeight="472" prefWidth="826" style="                 -fx-background-radius:12;                 -fx-border-radius:12;                 -fx-selection-bar: #f7931e;                 -fx-selection-bar-non-focused: #f7931e;             ">

			<columns>
				<TableColumn fx:id="colImage" prefWidth="90" style="-fx-alignment:CENTER;" text="Photo" />

				<TableColumn fx:id="colName" prefWidth="220" style="-fx-alignment:CENTER;" text="Name" />

				<TableColumn fx:id="colPhone" prefWidth="150" style="-fx-alignment:CENTER;" text="Phone" />

				<TableColumn fx:id="colBranch" prefWidth="160" style="-fx-alignment:CENTER;" text="Branch" />

				<TableColumn fx:id="colRate" prefWidth="130" style="-fx-alignment:CENTER;" text="Hourly Rate" />

				<TableColumn fx:id="colHire" prefWidth="110" style="-fx-alignment:CENTER;" text="Hire Date" />
			</columns>
		</TableView>
	</AnchorPane>

	<!-- ===== Actions ===== -->
	<HBox layoutX="53.0" layoutY="599.0" spacing="12">

		<Button fx:id="btnAnchor" onAction="#onEdit" style="                 -fx-background-color:#f7931e;                 -fx-text-fill:white;                 -fx-pref-width:100;                 -fx-background-radius:10;                 -fx-font-weight:800;             " text="Edit" />

		<!-- ❗ Delete button kept as requested -->
		<Button onAction="#onDelete" style="                 -fx-background-color:#C62828;                 -fx-text-fill:white;                 -fx-pref-width:100;                 -fx-background-radius:10;                 -fx-font-weight:800;             " text="Delete" />

		<Button onAction="#onView" style="                 -fx-background-color:#1E88E5;                 -fx-text-fill:white;                 -fx-pref-width:100;                 -fx-background-radius:10;                 -fx-font-weight:800;             " text="View" />

		<Button onAction="#onAttendance" style="                 -fx-background-color:#2E7D32;                 -fx-text-fill:white;                 -fx-pref-width:130;                 -fx-background-radius:10;                 -fx-font-weight:800;             " text="Attendance" />
	</HBox>

</AnchorPane>
