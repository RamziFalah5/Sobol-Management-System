<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<AnchorPane prefHeight="650" prefWidth="910" style="-fx-background-color:#f7f8fb;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.ShipmentProductsController">

	<!-- ===== Title ===== -->
	<Label layoutX="28.0" layoutY="14.0" style="-fx-font-size:22px; -fx-text-fill:#f7931e; -fx-font-weight:900;" text="Select Product (All Company)" />

	<!-- subtle underline -->
	<Region layoutX="28" layoutY="52" prefHeight="2" prefWidth="854" style="-fx-background-color: rgba(247,147,30,0.25); -fx-background-radius:10;" />

	<!-- ===== Search ===== -->
	<TextField fx:id="txtSearch" layoutX="670.0" layoutY="14.0" prefWidth="212" promptText="Search product…" style="             -fx-background-radius: 10;             -fx-background-color: white;             -fx-border-color:#f7931e;             -fx-border-radius:10;             -fx-padding: 6 12;         " />

	<!-- ===== Main Card ===== -->
	<AnchorPane layoutX="28" layoutY="70" prefHeight="554.0" prefWidth="874.0" style="             -fx-background-color:white;             -fx-background-radius:18;             -fx-padding:16;             -fx-border-color: rgba(0,0,0,0.05);             -fx-border-radius:18;             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.10), 24, 0.22, 0, 8);         ">

		<!-- ===== Table ===== -->
		<TableView fx:id="table" layoutX="14" layoutY="14" prefHeight="482.0" prefWidth="826" style="                 -fx-background-radius:12;                 -fx-border-radius:12;                 -fx-border-color:#e8e8e8;             ">

			<columns>
				<TableColumn fx:id="colImage" prefWidth="85" style="-fx-alignment:CENTER;" text="Image" />

				<TableColumn fx:id="colName" prefWidth="180" text="Product" />

				<TableColumn fx:id="colCategory" prefWidth="140" text="Category" />

				<TableColumn fx:id="colBranch" prefWidth="130" text="Branch" />

				<TableColumn fx:id="colWarehouse" prefWidth="150" text="Warehouse" />

				<TableColumn fx:id="colQty" prefWidth="70" style="-fx-alignment:CENTER;" text="Qty" />

				<TableColumn fx:id="colCartons" prefWidth="110" style="-fx-alignment:CENTER;" text="Cartons / Pallet" />

				<TableColumn fx:id="colCost" prefWidth="80" style="-fx-alignment:CENTER;" text="Cost" />
			</columns>
		</TableView>

		<!-- ===== Actions ===== -->
		<HBox layoutX="14.0" layoutY="514.0" spacing="10">
			<Button onAction="#onSelect" style="                     -fx-background-color:#2E7D32;                     -fx-text-fill:white;                     -fx-background-radius:10;                     -fx-pref-width:150;                     -fx-font-weight:800;                 " text="Select Product" />

			<Button onAction="#onBack" style="                     -fx-background-color:#1E88E5;                     -fx-text-fill:white;                     -fx-background-radius:10;                     -fx-pref-width:110;                     -fx-font-weight:800;                 " text="Back" />
		</HBox>

	</AnchorPane>

</AnchorPane>
