<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="742.0" prefWidth="910" style="-fx-background-color: linear-gradient(to bottom, #f7f8fb, #eef1f7);" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.EditProductController">

	<!-- Title -->
	<Label layoutX="28" layoutY="18" style="-fx-font-size:28px; -fx-text-fill:#f7931e; -fx-font-weight:900;" text="Edit Product" />

	<!-- Underline -->
	<Region layoutX="28" layoutY="56" prefHeight="2" prefWidth="854" style="-fx-background-color: rgba(247,147,30,0.22); -fx-background-radius: 10;" />

	<!-- Card -->
	<AnchorPane layoutX="28.0" layoutY="69.0" prefHeight="620" prefWidth="854" style="             -fx-background-color:white;             -fx-background-radius:18;             -fx-padding:20;             -fx-border-color: rgba(0,0,0,0.05);             -fx-border-radius:18;             -fx-effect:dropshadow(gaussian, rgba(0,0,0,0.10), 24, 0.22, 0, 8);         ">

		<!-- Header -->
		<VBox layoutX="20" layoutY="18" spacing="4">
			<Label style="-fx-font-size:16px; -fx-font-weight:900; -fx-text-fill:#222;" text="Edit Product Details" />
		</VBox>

		<!-- ID -->
		<Label fx:id="lblId" layoutX="20" layoutY="46" style="-fx-text-fill:#666; -fx-font-size:12px; -fx-font-weight:700;" text="ID: -" />

		<Separator layoutX="20" layoutY="72" prefWidth="814" style="-fx-opacity:0.55;" />

		<!-- Form -->
		<GridPane hgap="14" layoutX="20" layoutY="92" vgap="12">

			<columnConstraints>
				<ColumnConstraints prefWidth="170" />
				<ColumnConstraints prefWidth="360" />
			</columnConstraints>

			<rowConstraints>
				<RowConstraints />
				<RowConstraints />
				<RowConstraints />
				<RowConstraints />
				<RowConstraints />
				<RowConstraints />
				<RowConstraints />
				<RowConstraints />
				<RowConstraints />
				<RowConstraints />
				<RowConstraints />
			</rowConstraints>

			<!-- Branch -->
			<Label style="-fx-text-fill:#444; -fx-font-weight:800;" text="Branch" GridPane.rowIndex="0" />
			<ComboBox fx:id="cbBranch" prefWidth="330" style="                     -fx-background-radius:12;                     -fx-border-radius:12;                     -fx-border-color:#e7e7e7;                     -fx-background-color:#ffffff;                     -fx-padding:6 10;                 " GridPane.columnIndex="1" GridPane.rowIndex="0" />

			<!-- Warehouse -->
			<Label style="-fx-text-fill:#444; -fx-font-weight:800;" text="Warehouse" GridPane.rowIndex="1" />
			<ComboBox fx:id="cbWarehouse" prefWidth="330" style="                     -fx-background-radius:12;                     -fx-border-radius:12;                     -fx-border-color:#e7e7e7;                     -fx-background-color:#ffffff;                     -fx-padding:6 10;                 " GridPane.columnIndex="1" GridPane.rowIndex="1" />

			<!-- Name -->
			<Label style="-fx-text-fill:#444; -fx-font-weight:800;" text="Name" GridPane.rowIndex="2" />
			<TextField fx:id="txtName" promptText="Product name..." style="                     -fx-background-radius:12;                     -fx-border-radius:12;                     -fx-border-color:#e7e7e7;                     -fx-padding:8 10;                 " GridPane.columnIndex="1" GridPane.rowIndex="2" />

			<!-- Base Unit -->
			<Label style="-fx-text-fill:#444; -fx-font-weight:800;" text="Base Unit" GridPane.rowIndex="3" />
			<TextField fx:id="txtBaseUnit" promptText="Carton / Box / etc." style="                     -fx-background-radius:12;                     -fx-border-radius:12;                     -fx-border-color:#e7e7e7;                     -fx-padding:8 10;                 " GridPane.columnIndex="1" GridPane.rowIndex="3" />

			<!-- Cartons per Pallet -->
			<Label style="-fx-text-fill:#444; -fx-font-weight:800;" text="Cartons per Pallet" GridPane.rowIndex="4" />
			<TextField fx:id="txtCartonsPerPallet" promptText="e.g. 100" style="                     -fx-background-radius:12;                     -fx-border-radius:12;                     -fx-border-color:#e7e7e7;                     -fx-padding:8 10;                 " GridPane.columnIndex="1" GridPane.rowIndex="4" />

			<!-- Quantity -->
			<Label style="-fx-text-fill:#444; -fx-font-weight:800;" text="Quantity" GridPane.rowIndex="5" />
			<TextField fx:id="txtQuantity" promptText="e.g. 1000" style="                     -fx-background-radius:12;                     -fx-border-radius:12;                     -fx-border-color:#e7e7e7;                     -fx-padding:8 10;                 " GridPane.columnIndex="1" GridPane.rowIndex="5" />

			<!-- Min -->
			<Label style="-fx-text-fill:#444; -fx-font-weight:800;" text="Min Quantity" GridPane.rowIndex="6" />
			<TextField fx:id="txtMin" promptText="e.g. 200" style="                     -fx-background-radius:12;                     -fx-border-radius:12;                     -fx-border-color:#e7e7e7;                     -fx-padding:8 10;                 " GridPane.columnIndex="1" GridPane.rowIndex="6" />

			<!-- Max -->
			<Label style="-fx-text-fill:#444; -fx-font-weight:800;" text="Max Quantity" GridPane.rowIndex="7" />
			<TextField fx:id="txtMax" promptText="e.g. 2000" style="                     -fx-background-radius:12;                     -fx-border-radius:12;                     -fx-border-color:#e7e7e7;                     -fx-padding:8 10;                 " GridPane.columnIndex="1" GridPane.rowIndex="7" />

			<!-- Cost -->
			<Label style="-fx-text-fill:#444; -fx-font-weight:800;" text="Cost Price" GridPane.rowIndex="8" />
			<TextField fx:id="txtCost" promptText="e.g. 10.5" style="                     -fx-background-radius:12;                     -fx-border-radius:12;                     -fx-border-color:#e7e7e7;                     -fx-padding:8 10;                 " GridPane.columnIndex="1" GridPane.rowIndex="8" />

			<!-- Sell -->
			<Label style="-fx-text-fill:#444; -fx-font-weight:800;" text="Selling Price" GridPane.rowIndex="9" />
			<TextField fx:id="txtSell" promptText="e.g. 12.0" style="                     -fx-background-radius:12;                     -fx-border-radius:12;                     -fx-border-color:#e7e7e7;                     -fx-padding:8 10;                 " GridPane.columnIndex="1" GridPane.rowIndex="9" />

			<!-- Description -->
			<Label style="-fx-text-fill:#444; -fx-font-weight:800;" text="Description" GridPane.rowIndex="10" />
			<TextArea fx:id="txtDescription" prefRowCount="4" promptText="Write a short description..." style="                     -fx-background-radius:12;                     -fx-border-radius:12;                     -fx-border-color:#e7e7e7;                     -fx-padding:8 10;                 " GridPane.columnIndex="1" GridPane.rowIndex="10" />
		</GridPane>

		<!-- Vertical divider -->
		<Separator layoutX="560" layoutY="92" orientation="VERTICAL" prefHeight="395" style="-fx-opacity:0.35;" />

		<!-- Right side image -->
		<Label layoutX="610" layoutY="92" style="-fx-text-fill:#222; -fx-font-size:16px; -fx-font-weight:900;" text="Image" />

		<Label layoutX="610" layoutY="112" style="-fx-text-fill:#7a7a7a; -fx-font-size:12px;" text="Current / selected product image preview" />

		<StackPane layoutX="610" layoutY="145" prefHeight="190" prefWidth="210" style="                 -fx-background-color: linear-gradient(to bottom, #ffffff, #f7f8fb);                 -fx-border-color:#e7e7e7;                 -fx-border-radius:16;                 -fx-background-radius:16;                 -fx-padding:10;                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 14, 0.2, 0, 4);             ">
			<ImageView fx:id="imgPreview" fitHeight="170" fitWidth="190" preserveRatio="true" />
		</StackPane>

		<Button layoutX="610" layoutY="353" onAction="#chooseImage" style="                 -fx-background-color: linear-gradient(to bottom right, #1E88E5, #1565C0);                 -fx-text-fill:white;                 -fx-font-weight:900;                 -fx-background-radius:14;                 -fx-pref-width:210;                 -fx-pref-height:42;                 -fx-cursor:hand;                 -fx-effect: dropshadow(gaussian, rgba(21,101,192,0.22), 18, 0.25, 0, 6);             " text="Choose Image" />

		<!-- Bottom actions -->
		<HBox layoutX="604.0" layoutY="582.0" spacing="12">
			<Button onAction="#onSave" style="                     -fx-background-color: linear-gradient(to bottom, #2E7D32, #1B5E20);                     -fx-text-fill:white;                     -fx-font-weight:900;                     -fx-background-radius:14;                     -fx-pref-width:110;                     -fx-pref-height:42;                     -fx-cursor:hand;                     -fx-effect: dropshadow(gaussian, rgba(27,94,32,0.22), 18, 0.25, 0, 6);                 " text="Save" />
			<Button onAction="#onCancel" style="                     -fx-background-color: linear-gradient(to bottom, #E53935, #C62828);                     -fx-text-fill:white;                     -fx-font-weight:900;                     -fx-background-radius:14;                     -fx-pref-width:110;                     -fx-pref-height:42;                     -fx-cursor:hand;                     -fx-effect: dropshadow(gaussian, rgba(198,40,40,0.20), 18, 0.25, 0, 6);                 " text="Cancel" />
		</HBox>

		<Label layoutX="202.0" layoutY="659.0" style="-fx-text-fill:#8a8a8a; -fx-font-size:12px;" text="Tip: Make sure Warehouse has enough pallet capacity before saving." />
			<Label layoutX="634.0" layoutY="31.0" style="-fx-font-size:12px; -fx-text-fill:#7a7a7a;" text="Update information then press Save" />

	</AnchorPane>

</AnchorPane>
