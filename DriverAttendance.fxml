<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefWidth="910" prefHeight="650"
	xmlns="http://javafx.com/javafx/23.0.1"
	xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="application.DriverAttendanceController"
	style="-fx-background-color:white;">

	<Label layoutX="28" layoutY="24" text="Driver Attendance"
		style="-fx-font-size:22px; -fx-text-fill:#f7931e; -fx-font-weight:bold;" />

	<TableView fx:id="table" layoutX="28" layoutY="70"
		prefWidth="854" prefHeight="500"
		style="-fx-background-radius:12; -fx-border-radius:12; -fx-border-color:#e8e8e8;">
		<columns>
			<TableColumn fx:id="colName" text="Name" prefWidth="420" />
			<TableColumn fx:id="colBranch" text="Branch"
				prefWidth="240" />
			<TableColumn fx:id="colPresent" text="Present"
				prefWidth="180" />
		</columns>
	</TableView>

	<HBox layoutX="28" layoutY="585" spacing="10">
		<Button fx:id="btnAnchor" text="Save" onAction="#onSave"
			style="-fx-background-color:#2E7D32; -fx-text-fill:white; -fx-pref-width:120; -fx-background-radius:10;" />
		<Button text="Cancel" onAction="#onCancel"
			style="-fx-background-color:#C62828; -fx-text-fill:white; -fx-pref-width:120; -fx-background-radius:10;" />
	</HBox>

</AnchorPane>
