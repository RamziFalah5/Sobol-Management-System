<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefWidth="910" prefHeight="650"
	xmlns="http://javafx.com/javafx/23.0.1"
	xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="application.CustomersController"
	style="-fx-background-color:white;">

	<Label layoutX="28" layoutY="24" text="Customers"
		style="-fx-font-size:22px; -fx-text-fill:#f7931e; -fx-font-weight:bold;" />

	<TextField fx:id="txtSearch" layoutX="690" layoutY="28"
		prefWidth="200" promptText="Search customer…"
		style="-fx-background-radius: 8; -fx-background-color: #f7931e; -fx-text-fill: white; -fx-prompt-text-fill: white; -fx-padding: 6 10;" />

	<TableView fx:id="table" layoutX="28" layoutY="70"
		prefWidth="854" prefHeight="520"
		style="-fx-background-radius:12; -fx-border-radius:12; -fx-border-color:#e8e8e8;">
		<columns>
			<TableColumn fx:id="colName" text="Name" prefWidth="240" />
			<TableColumn fx:id="colPhone" text="Phone"
				prefWidth="160" />
			<TableColumn fx:id="colEmail" text="Email"
				prefWidth="220" />
			<TableColumn fx:id="colCity" text="City" prefWidth="140" />
			<TableColumn fx:id="colAddress" text="Address"
				prefWidth="180" />
		</columns>
	</TableView>

	<HBox layoutX="28" layoutY="605" spacing="10">
		<Button text="Add" onAction="#onAdd"
			style="-fx-background-color:#43A047; -fx-text-fill:white; -fx-background-radius:10;" />
		<Button text="Edit" onAction="#onEdit"
			style="-fx-background-color:#f7931e; -fx-text-fill:white; -fx-background-radius:10;" />
		<Button text="View" disable="true"
			style="-fx-background-color:#1E88E5; -fx-text-fill:white; -fx-background-radius:10;" />
	</HBox>

</AnchorPane>
