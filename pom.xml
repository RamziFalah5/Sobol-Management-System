<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.sobol</groupId>
  <artifactId>sobol-management-system</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>Sobol Management System</name>
  <description>Recovered JavaFX desktop application; controlled development baseline.</description>
  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <maven.compiler.release>21</maven.compiler.release>
    <javafx.version>24.0.1</javafx.version>
    <postgresql.version>42.7.14</postgresql.version>
    <flyway.version>13.12.1</flyway.version>
    <junit.version>5.11.4</junit.version>
    <desktop.test.exclude>**/ApplicationStartupTest.java</desktop.test.exclude>
    <controller.desktop.test.exclude>**/*DesktopTest.java</controller.desktop.test.exclude>
    <test.reuse.forks>true</test.reuse.forks>
  </properties>
  <dependencies>
    <dependency><groupId>org.openjfx</groupId><artifactId>javafx-controls</artifactId><version>${javafx.version}</version></dependency>
    <dependency><groupId>org.openjfx</groupId><artifactId>javafx-fxml</artifactId><version>${javafx.version}</version></dependency>
    <dependency><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId><version>${postgresql.version}</version></dependency>
    <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-core</artifactId><version>${flyway.version}</version><scope>test</scope></dependency>
    <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-database-postgresql</artifactId><version>${flyway.version}</version><scope>test</scope></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>${junit.version}</version><scope>test</scope></dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-clean-plugin</artifactId><version>3.4.1</version></plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-resources-plugin</artifactId><version>3.3.1</version></plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.11.0</version></plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-enforcer-plugin</artifactId><version>3.5.0</version>
        <executions><execution><id>recovery-toolchain</id><goals><goal>enforce</goal></goals>
          <configuration><rules>
            <requireJavaVersion><version>[22,23)</version><message>The recovery baseline uses JDK 22 (JavaFX 24 requires JDK 22+), compiling with release 21.</message></requireJavaVersion>
            <requireMavenVersion><version>[3.9.0,4.0.0)</version></requireMavenVersion>
          </rules></configuration>
        </execution></executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.2.5</version>
        <configuration>
          <useModulePath>false</useModulePath>
          <excludes><exclude>${desktop.test.exclude}</exclude><exclude>${controller.desktop.test.exclude}</exclude></excludes>
          <reuseForks>${test.reuse.forks}</reuseForks>
          <environmentVariables><SOBOL_DB_ENABLED>false</SOBOL_DB_ENABLED><SOBOL_PG_ENABLED>false</SOBOL_PG_ENABLED></environmentVariables>
        </configuration>
      </plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><version>3.4.2</version></plugin>
      <plugin>
        <groupId>org.openjfx</groupId><artifactId>javafx-maven-plugin</artifactId><version>0.0.8</version>
        <configuration><mainClass>application.Main</mainClass></configuration>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>postgres-it</id>
      <build><plugins><plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-failsafe-plugin</artifactId><version>3.2.5</version>
        <configuration><useModulePath>false</useModulePath><failIfNoTests>true</failIfNoTests>
          <includes><include>**/PostgresPersistenceIT.java</include><include>**/PostgresAuthenticationIT.java</include></includes>
          <systemPropertyVariables><junit.jupiter.execution.parallel.enabled>false</junit.jupiter.execution.parallel.enabled></systemPropertyVariables>
          <forkCount>1</forkCount><reuseForks>true</reuseForks>
        </configuration>
        <executions><execution><goals><goal>integration-test</goal><goal>verify</goal></goals></execution></executions>
      </plugin></plugins></build>
    </profile>
    <profile>
      <id>postgres-migrate</id>
      <build><plugins><plugin>
        <groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId><version>3.5.0</version>
        <configuration><mainClass>com.sobol.database.PostgresMigrations</mainClass><classpathScope>test</classpathScope></configuration>
      </plugin></plugins></build>
    </profile>
    <profile>
      <id>postgres-accounts</id>
      <build><plugins><plugin>
        <groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId><version>3.5.0</version>
        <configuration><executable>java</executable><classpathScope>test</classpathScope><inheritIo>true</inheritIo>
          <arguments><argument>-cp</argument><classpath/><argument>com.sobol.database.PostgresAccounts</argument><argument>${sobol.account.action}</argument></arguments>
        </configuration>
      </plugin></plugins></build>
    </profile>
    <profile><id>desktop-smoke</id><properties>
      <desktop.test.exclude>**/NoTestsExcluded.java</desktop.test.exclude>
      <controller.desktop.test.exclude>**/NoTestsExcluded.java</controller.desktop.test.exclude>
      <test.reuse.forks>false</test.reuse.forks>
    </properties></profile>
  </profiles>
</project>
