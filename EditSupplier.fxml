<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="631.0" prefWidth="910"
	style="-fx-background-color:#f7f8fb;"
	xmlns="http://javafx.com/javafx/23.0.1"
	xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="application.EditSupplierController">

	<Label layoutX="28" layoutY="24" text="Edit Supplier"
		style="-fx-font-size:24px; -fx-text-fill:#f7931e; -fx-font-weight:bold;" />

	<Label fx:id="lblId" layoutX="28" layoutY="52" text="ID: -"
		style="-fx-text-fill:#666;" />

	<AnchorPane layoutX="28" layoutY="70" prefHeight="520"
		prefWidth="854"
		style="-fx-background-color:white; -fx-background-radius:14; -fx-padding:20;
                       -fx-effect:dropshadow(gaussian, rgba(0,0,0,0.08), 20, 0, 0, 4);">

		<GridPane layoutX="20" layoutY="20" hgap="14" vgap="12">
			<columnConstraints>
				<ColumnConstraints prefWidth="170" />
				<ColumnConstraints prefWidth="420" />
			</columnConstraints>

			<Label text="Name *" GridPane.rowIndex="0" />
			<TextField fx:id="txtName" GridPane.columnIndex="1"
				GridPane.rowIndex="0" />

			<Label text="Phone *" GridPane.rowIndex="1" />
			<TextField fx:id="txtPhone" GridPane.columnIndex="1"
				GridPane.rowIndex="1" />

			<Label text="Email" GridPane.rowIndex="2" />
			<TextField fx:id="txtEmail" GridPane.columnIndex="1"
				GridPane.rowIndex="2" />

			<Label text="City" GridPane.rowIndex="3" />
			<TextField fx:id="txtCity" GridPane.columnIndex="1"
				GridPane.rowIndex="3" />

			<Label text="Address" GridPane.rowIndex="4" />
			<TextField fx:id="txtAddress" GridPane.columnIndex="1"
				GridPane.rowIndex="4" />

			<Label text="Contact Person" GridPane.rowIndex="5" />
			<TextField fx:id="txtContact" GridPane.columnIndex="1"
				GridPane.rowIndex="5" />

			<Label text="Notes" GridPane.rowIndex="6" />
			<TextArea fx:id="txtNotes" prefRowCount="4"
				GridPane.columnIndex="1" GridPane.rowIndex="6" />
		</GridPane>

		<HBox layoutX="20" layoutY="460" spacing="12">
			<Button text="Save" onAction="#onSave"
				style="-fx-background-color:#f7931e; -fx-text-fill:white; -fx-pref-width:90;" />
			<Button text="Cancel" onAction="#onCancel"
				style="-fx-background-color:#C62828; -fx-text-fill:white; -fx-pref-width:90;" />
		</HBox>

	</AnchorPane>
</AnchorPane>
