<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Rectangle?>

<AnchorPane prefWidth="900" prefHeight="600"
	xmlns="http://javafx.com/javafx/23.0.1"
	xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="application.EditDriverController"
	style="-fx-background-color:#f7f8fb;">

	<Label layoutX="28" layoutY="20" text="Edit Truck Driver"
		style="-fx-font-size:22px; -fx-text-fill:#f7931e; -fx-font-weight:bold;" />

	<AnchorPane layoutX="28" layoutY="60" prefWidth="844"
		prefHeight="500"
		style="-fx-background-color:white; -fx-background-radius:14; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 20, 0, 0, 4);">

		<GridPane layoutX="24" layoutY="28" hgap="14" vgap="12">
			<Label text="Full Name:" />
			<TextField fx:id="txtFullName" prefWidth="240"
				GridPane.columnIndex="1" />

			<Label text="Phone:" GridPane.rowIndex="1" />
			<TextField fx:id="txtPhone" GridPane.rowIndex="1"
				GridPane.columnIndex="1" />

			<Label text="Branch:" GridPane.rowIndex="2" />
			<ComboBox fx:id="cbBranch" prefWidth="240"
				promptText="Select branch..." GridPane.rowIndex="2"
				GridPane.columnIndex="1" />

			<Label text="Hire Date:" GridPane.rowIndex="3" />
			<DatePicker fx:id="dpHireDate" GridPane.rowIndex="3"
				GridPane.columnIndex="1" />

			<Label text="Driver Daily Rate:" GridPane.rowIndex="4" />
			<TextField fx:id="txtRate" promptText="e.g. 150"
				GridPane.rowIndex="4" GridPane.columnIndex="1" />

			<Label text="Vehicle:" GridPane.rowIndex="5" />
			<ComboBox fx:id="cbVehicle" prefWidth="240"
				promptText="Select vehicle..." GridPane.rowIndex="5"
				GridPane.columnIndex="1" />

			<Label text="Image:" GridPane.rowIndex="6" />
			<HBox GridPane.rowIndex="6" GridPane.columnIndex="1"
				spacing="10">
				<Button text="Choose Image" onAction="#chooseImage"
					style="-fx-background-color:#f7931e; -fx-text-fill:white; -fx-background-radius:10;" />
				<Label fx:id="lblImageInfo" text="No image selected"
					style="-fx-text-fill:#777;" />
			</HBox>
		</GridPane>

		<StackPane layoutX="560" layoutY="40" prefWidth="220"
			prefHeight="220" style="-fx-border-color:#ddd; -fx-border-width:1;">
			<clip>
				<Rectangle width="220" height="220" />
			</clip>
			<children>
				<ImageView fx:id="imgPreview" fitWidth="220"
					fitHeight="220" preserveRatio="true" />
			</children>
		</StackPane>

		<HBox layoutX="24" layoutY="440" spacing="12">
			<Button fx:id="btnAnchor" text="Save" onAction="#onSave"
				style="-fx-background-color:#2E7D32; -fx-text-fill:white; -fx-pref-width:120; -fx-background-radius:10;" />
			<Button text="Cancel" onAction="#onCancel"
				style="-fx-background-color:#C62828; -fx-text-fill:white; -fx-pref-width:120; -fx-background-radius:10;" />
		</HBox>

	</AnchorPane>
</AnchorPane>
