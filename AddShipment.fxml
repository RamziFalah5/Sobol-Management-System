<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefWidth="910" prefHeight="650"
	xmlns="http://javafx.com/javafx/23.0.1"
	xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="application.AddShipmentController"
	style="-fx-background-color:linear-gradient(to bottom, #f7f8fb, #eef1f7);">

	<!-- ================= TITLE ================= -->
	<VBox layoutX="28" layoutY="20" spacing="6">
		<Label text="New Shipment"
			style="-fx-font-size:26px; -fx-text-fill:#f7931e; -fx-font-weight:900;" />
		<Label text="Register incoming stock shipment into the system"
			style="-fx-font-size:13px; -fx-text-fill:#7a7a7a;" />
	</VBox>

	<!-- ================= MAIN CARD ================= -->
	<AnchorPane layoutX="28" layoutY="80" prefWidth="854"
		prefHeight="540"
		style="
            -fx-background-color:white;
            -fx-background-radius:22;
            -fx-padding:22;
            -fx-border-color: rgba(0,0,0,0.04);
            -fx-border-radius:22;
            -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 28, 0.25, 0, 10);
        ">

		<!-- ================= SECTION: PRODUCT INFO ================= -->
		<VBox layoutX="20" layoutY="18" spacing="8">
			<Label text="Product Information"
				style="-fx-font-size:15px; -fx-font-weight:900; -fx-text-fill:#333;" />
			<Region prefWidth="810" prefHeight="1"
				style="-fx-background-color:#e8e8e8;" />
		</VBox>

		<GridPane layoutX="20" layoutY="55" hgap="16" vgap="14">
			<columnConstraints>
				<ColumnConstraints prefWidth="170" />
				<ColumnConstraints prefWidth="280" />
				<ColumnConstraints prefWidth="170" />
				<ColumnConstraints prefWidth="180" />
			</columnConstraints>

			<Label text="Product" GridPane.rowIndex="0"
				GridPane.columnIndex="0" />
			<TextField fx:id="txtProduct" editable="false"
				GridPane.rowIndex="0" GridPane.columnIndex="1"
				style="-fx-background-color:#f7f8fb; -fx-font-weight:700;" />

			<Label text="Category" GridPane.rowIndex="0"
				GridPane.columnIndex="2" />
			<TextField fx:id="txtCategory" editable="false"
				GridPane.rowIndex="0" GridPane.columnIndex="3"
				style="-fx-background-color:#f7f8fb;" />

			<Label text="Cartons / Pallet" GridPane.rowIndex="1"
				GridPane.columnIndex="0" />
			<TextField fx:id="txtCartons" editable="false"
				GridPane.rowIndex="1" GridPane.columnIndex="1"
				style="-fx-background-color:#f7f8fb;" />

			<Label text="Current Stock" GridPane.rowIndex="1"
				GridPane.columnIndex="2" />
			<TextField fx:id="txtCurrentQty" editable="false"
				GridPane.rowIndex="1" GridPane.columnIndex="3"
				style="-fx-background-color:#f7f8fb;" />
		</GridPane>

		<!-- ================= SECTION: DESTINATION ================= -->
		<VBox layoutX="20" layoutY="155" spacing="8">
			<Label text="Destination"
				style="-fx-font-size:15px; -fx-font-weight:900; -fx-text-fill:#333;" />
			<Region prefWidth="810" prefHeight="1"
				style="-fx-background-color:#e8e8e8;" />
		</VBox>

		<GridPane layoutX="20" layoutY="192" hgap="16" vgap="14">
			<columnConstraints>
				<ColumnConstraints prefWidth="170" />
				<ColumnConstraints prefWidth="280" />
				<ColumnConstraints prefWidth="170" />
				<ColumnConstraints prefWidth="180" />
			</columnConstraints>

			<Label text="Branch" GridPane.rowIndex="0"
				GridPane.columnIndex="0" />
			<ComboBox fx:id="cbBranch" GridPane.rowIndex="0"
				GridPane.columnIndex="1" />

			<Label text="Warehouse" GridPane.rowIndex="0"
				GridPane.columnIndex="2" />
			<ComboBox fx:id="cbWarehouse" GridPane.rowIndex="0"
				GridPane.columnIndex="3" />

			<Label text="Supplier" GridPane.rowIndex="1"
				GridPane.columnIndex="0" />
			<ComboBox fx:id="cbSupplier" GridPane.rowIndex="1"
				GridPane.columnIndex="1" />

			<Label text="Shipment Date" GridPane.rowIndex="1"
				GridPane.columnIndex="2" />
			<DatePicker fx:id="dpDate" GridPane.rowIndex="1"
				GridPane.columnIndex="3" />
		</GridPane>

		<!-- ================= SECTION: QUANTITY & COST ================= -->
		<VBox layoutX="20" layoutY="290" spacing="8">
			<Label text="Quantity &amp; Cost"
				style="-fx-font-size:15px; -fx-font-weight:900; -fx-text-fill:#333;" />
			<Region prefWidth="810" prefHeight="1"
				style="-fx-background-color:#e8e8e8;" />
		</VBox>

		<GridPane layoutX="20" layoutY="327" hgap="16" vgap="14">
			<columnConstraints>
				<ColumnConstraints prefWidth="170" />
				<ColumnConstraints prefWidth="280" />
				<ColumnConstraints prefWidth="170" />
				<ColumnConstraints prefWidth="180" />
			</columnConstraints>

			<Label text="Quantity (Cartons)" GridPane.rowIndex="0"
				GridPane.columnIndex="0" />
			<TextField fx:id="txtQty" promptText="e.g. 650"
				GridPane.rowIndex="0" GridPane.columnIndex="1" />

			<Label text="Unit Cost" GridPane.rowIndex="0"
				GridPane.columnIndex="2" />
			<TextField fx:id="txtUnitCost" editable="false"
				GridPane.rowIndex="0" GridPane.columnIndex="3"
				style="-fx-background-color:#f7f8fb;" />

			<Label text="Total Cost" GridPane.rowIndex="1"
				GridPane.columnIndex="0" />
			<TextField fx:id="txtTotal" editable="false"
				GridPane.rowIndex="1" GridPane.columnIndex="1"
				style="-fx-background-color:#f7f8fb; -fx-font-weight:900; -fx-text-fill:#2E7D32;" />

			<Label text="Reference No" GridPane.rowIndex="1"
				GridPane.columnIndex="2" />
			<TextField fx:id="txtRef" promptText="Optional"
				GridPane.rowIndex="1" GridPane.columnIndex="3" />
		</GridPane>

		<!-- ================= NOTES ================= -->
		<Label layoutX="20" layoutY="415" text="Notes"
			style="-fx-font-weight:800;" />
		<TextArea fx:id="txtNotes" layoutX="20" layoutY="438"
			prefWidth="810" prefRowCount="3" />

		<!-- ================= ACTIONS ================= -->
		<HBox layoutX="20" layoutY="500" spacing="14">
			<Button text="Save Shipment" onAction="#onSave"
				style="-fx-background-color:#2E7D32; -fx-text-fill:white; -fx-pref-width:160; -fx-background-radius:12; -fx-font-weight:900;" />
			<Button text="Cancel" onAction="#onCancel"
				style="-fx-background-color:#C62828; -fx-text-fill:white; -fx-pref-width:120; -fx-background-radius:12; -fx-font-weight:900;" />
		</HBox>

	</AnchorPane>

</AnchorPane>
