<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<AnchorPane prefHeight="684" prefWidth="910" style="-fx-background-color: linear-gradient(to bottom, #ffffff, #fff6ec);" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.CategoryController">

	<!-- Top Bar -->
	<AnchorPane layoutX="18" layoutY="18" prefHeight="60" prefWidth="874" style="-fx-background-color: white;                        -fx-background-radius: 14;                        -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 18, 0.25, 0, 6);">

		<Label layoutX="18" layoutY="14" style="-fx-font-size:22px; -fx-text-fill:#f7931e; -fx-font-weight:bold;" text="Category Management" />

		<!-- Search -->
		<TextField fx:id="txtSearch" layoutX="604" layoutY="14" promptText="Search by name / description..." style="-fx-background-radius:12;                           -fx-background-color:#f7931e;                           -fx-text-fill:white;                           -fx-prompt-text-fill:rgba(255,255,255,0.85);                           -fx-padding:9 12;                           -fx-font-size:13px;                           -fx-pref-width:240;" />
	</AnchorPane>

	<!-- Content Card -->
	<AnchorPane layoutX="18" layoutY="92" prefHeight="520" prefWidth="874" style="-fx-background-color: rgba(255,255,255,0.95);                        -fx-background-radius: 16;                        -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.10), 18, 0.22, 0, 6);">

		<ScrollPane fx:id="scrollCategories" fitToWidth="true" hbarPolicy="NEVER" layoutX="12" layoutY="44" prefHeight="462" prefWidth="850" style="-fx-background-color: transparent; -fx-background: transparent;" vbarPolicy="AS_NEEDED">

			<content>
				<GridPane fx:id="categoryGrid" hgap="16" style="-fx-padding: 14 14 18 14;" vgap="16">
					<!-- Cards injected from controller -->
				</GridPane>
			</content>
		</ScrollPane>

		<Label fx:id="lblEmpty" alignment="CENTER" layoutX="0" layoutY="235" prefWidth="874" style="-fx-font-size:16px; -fx-text-fill:#90A4AE; -fx-font-weight:bold;" text="No categories found." visible="false" />

		<Label fx:id="lblStats" layoutX="21.0" layoutY="23.0" style="-fx-font-size:13px; -fx-text-fill:#546E7A;" text="0 categories" />
	</AnchorPane>

	<!-- Bottom Buttons -->
	<HBox layoutX="18" layoutY="628" spacing="10">

		<Button onAction="#openAddCategory" style="-fx-background-color:#43A047;                        -fx-text-fill:white;                        -fx-background-radius:12;                        -fx-padding:10 18;                        -fx-font-size:14px;                        -fx-font-weight:bold;                        -fx-effect:dropshadow(gaussian, rgba(67,160,71,0.35), 14, 0.25, 0, 6);" text="Add" />

		<Button onAction="#editCategory" style="-fx-background-color:#f7931e;                        -fx-text-fill:white;                        -fx-background-radius:12;                        -fx-padding:10 18;                        -fx-font-size:14px;                        -fx-font-weight:bold;                        -fx-effect:dropshadow(gaussian, rgba(247,147,30,0.35), 14, 0.25, 0, 6);" text="Edit" />

		<Region prefWidth="650" />

		<Label fx:id="lblSelected" style="-fx-font-size:13px; -fx-text-fill:#607D8B;" text="Selected: none" />
	</HBox>

</AnchorPane>
