# PostgreSQL development only. This example is not automatically loaded.
# Owner must prepare the isolated target and approve operations separately.
SOBOL_PG_ENABLED=false
SOBOL_PG_URL=jdbc:postgresql://127.0.0.1:5432/sobol_dev
SOBOL_PG_USER=sobol_app
SOBOL_PG_PASSWORD=
# Absolute path to a trusted local server CA certificate; certificate must cover 127.0.0.1.
SOBOL_PG_SSLROOTCERT=
SOBOL_PG_MIGRATION_USER=sobol_migrator
SOBOL_PG_MIGRATION_PASSWORD=
# Leave empty until each operation is separately reviewed and approved.
SOBOL_PG_MIGRATION_APPROVED=
SOBOL_PG_IT_APPROVED=

# Registration is closed by default; opt-in creates PENDING MEMBER only.
SOBOL_REGISTRATION_ENABLED=false
# Separate explicit owner approval for account DML; never implies migration approval.
SOBOL_PG_ACCOUNT_ADMIN_APPROVED=
