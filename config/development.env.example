# Documentation template only. The application does not auto-load this file.
# Database access stays disabled unless explicitly enabled in the process environment.
SOBOL_DB_ENABLED=false
SOBOL_DB_URL=jdbc:mysql://127.0.0.1:3306/sobol_dev?sslMode=REQUIRED&serverTimezone=UTC
SOBOL_DB_USER=
SOBOL_DB_PASSWORD=
# Phase 2 tooling additionally requires these explicit confirmations (not auto-loaded):
# Set rotation confirmation only after the owner has actually rotated/revoked old credentials.
SOBOL_CREDENTIAL_ROTATION_CONFIRMED=false
SOBOL_IT_CONFIRM=
SOBOL_DB_SETUP_CONFIRM=
SOBOL_DB_SETUP_USER=
SOBOL_DB_SETUP_PASSWORD=
# Application identity must be sobol_app. Setup uses a different account and password.
# See docs/DEVELOPMENT-DATABASE.md before enabling access or filling confirmations.
